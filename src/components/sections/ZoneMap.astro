---
import type { Zone } from '@/types';

interface Props {
  zones: Zone[];
}

const { zones } = Astro.props;

// Regrouper les zones par frais de livraison
const freeZones = zones.filter(z => z.deliveryFee === 0);
const paidZones = zones.filter(z => z.deliveryFee > 0);
---

<section class="section-spacing bg-white">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="text-display-sm md:text-display-md font-display font-bold text-neutral-900 mb-4">
        Zones d'intervention
      </h2>
      <p class="text-xl text-neutral-600 max-w-2xl mx-auto">
        Nous intervenons à Tours et dans toute l'Indre-et-Loire. Livraison rapide partout dans le département.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Map -->
      <div class="order-2 lg:order-1">
        <div class="aspect-square rounded-xl overflow-hidden shadow-medium">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d84546.15384857245!2d0.6332542!3d47.3900474!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47fcd4e5ac72c61b%3A0x40dc8d7a8f4b0!2sTours!5e0!3m2!1sfr!2sfr!4v1234567890"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Carte des zones d'intervention RP Location de Benne"
          ></iframe>
        </div>
      </div>

      <!-- Zones list -->
      <div class="order-1 lg:order-2">
        <!-- Zones gratuites -->
        <div class="mb-8">
          <h3 class="text-2xl font-bold text-neutral-900 mb-4 flex items-center">
            <svg class="w-6 h-6 text-green-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Livraison gratuite
          </h3>
          <div class="flex flex-wrap gap-2">
            {freeZones.map((zone) => (
              <span class="inline-flex items-center px-3 py-2 bg-green-100 text-green-800 rounded-lg text-sm font-medium">
                {zone.name} ({zone.postalCode})
              </span>
            ))}
          </div>
        </div>

        <!-- Zones payantes -->
        <div>
          <h3 class="text-2xl font-bold text-neutral-900 mb-4 flex items-center">
            <svg class="w-6 h-6 text-primary-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z" />
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd" />
            </svg>
            Autres communes
          </h3>
          <div class="space-y-2">
            {paidZones.map((zone) => (
              <div class="flex items-center justify-between px-4 py-3 bg-neutral-50 rounded-lg">
                <span class="font-medium text-neutral-900">
                  {zone.name} ({zone.postalCode})
                </span>
                <span class="text-sm font-semibold text-primary-600">
                  +{zone.deliveryFee}€
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-8 p-6 bg-primary-50 rounded-xl border-2 border-primary-200">
          <h4 class="font-bold text-lg text-neutral-900 mb-2">
            Votre commune ne figure pas dans la liste ?
          </h4>
          <p class="text-neutral-600 mb-4">
            Contactez-nous pour connaître nos conditions de livraison dans votre secteur.
          </p>
          <a
            href="/contact"
            class="inline-flex items-center px-6 py-3 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition-colors"
          >
            Nous contacter
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
