---
interface Props {
  title?: string;
  image?: string;
  imageAlt?: string;
  class?: string;
  hoverable?: boolean;
}

const {
  title,
  image,
  imageAlt = '',
  class: className = '',
  hoverable = true
} = Astro.props;

const cardClasses = `bg-white rounded-xl shadow-soft overflow-hidden ${
  hoverable ? 'hover:shadow-medium transition-shadow duration-300' : ''
} ${className}`;
---

<div class={cardClasses}>
  {image && (
    <div class="aspect-video overflow-hidden">
      <img
        src={image}
        alt={imageAlt}
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-6">
    {title && (
      <h3 class="text-xl font-bold text-neutral-900 mb-3">{title}</h3>
    )}
    <slot />
  </div>
</div>
