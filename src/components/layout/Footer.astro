---
const currentYear = new Date().getFullYear();
---

<footer class="bg-neutral-900 text-white">
  <div class="container-custom py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      <!-- Colonne 1 : À propos -->
      <div>
        <div class="flex items-center space-x-3 mb-4">
          <div class="w-10 h-10 bg-primary-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-lg">RL</span>
          </div>
          <div class="font-display font-bold text-lg">Rudy Location 37</div>
        </div>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Spécialiste de la location de bennes dans le département d'Indre-et-Loire (37) et la région Centre. Solutions adaptées pour professionnels et particuliers.
        </p>
      </div>

      <!-- Colonne 2 : Services -->
      <div>
        <h3 class="font-display font-bold text-lg mb-4">Nos services</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/services/benne-10m3" class="text-neutral-400 hover:text-white transition-colors">Benne 10m³</a></li>
          <li><a href="/services/benne-15m3" class="text-neutral-400 hover:text-white transition-colors">Benne 15m³</a></li>
          <li><a href="/services/benne-20m3" class="text-neutral-400 hover:text-white transition-colors">Benne 20m³</a></li>
          <li><a href="/services/benne-30m3" class="text-neutral-400 hover:text-white transition-colors">Benne 30m³</a></li>
          <li><a href="/services/benne-gravats" class="text-neutral-400 hover:text-white transition-colors">Benne gravats</a></li>
        </ul>
      </div>

      <!-- Colonne 3 : Liens utiles -->
      <div>
        <h3 class="font-display font-bold text-lg mb-4">Liens utiles</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/tarifs" class="text-neutral-400 hover:text-white transition-colors">Devis gratuit</a></li>
          <li><a href="/zones-intervention" class="text-neutral-400 hover:text-white transition-colors">Zones d'intervention</a></li>
          <li><a href="/contact" class="text-neutral-400 hover:text-white transition-colors">Contact</a></li>
          <li><a href="/mentions-legales" class="text-neutral-400 hover:text-white transition-colors">Mentions légales</a></li>
        </ul>
      </div>

      <!-- Colonne 4 : Contact -->
      <div>
        <h3 class="font-display font-bold text-lg mb-4">Contact</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-neutral-400">Tours (37000)<br/>Indre-et-Loire</span>
          </li>
          <li class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-primary-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+33631464350" class="text-neutral-400 hover:text-white transition-colors">06 31 46 43 50</a>
          </li>
          <li class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-primary-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:contact@rp-locationdebenne37.fr" class="text-neutral-400 hover:text-white transition-colors">contact@rp-locationdebenne37.fr</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-neutral-800">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
        <p class="text-neutral-500 text-sm">
          &copy; {currentYear} Rudy Location 37. Tous droits réservés.
        </p>
        <div class="flex items-center space-x-6">
          <a href="/mentions-legales" class="text-neutral-500 hover:text-white text-sm transition-colors">
            Mentions légales
          </a>
          <a href="/mentions-legales#rgpd" class="text-neutral-500 hover:text-white text-sm transition-colors">
            RGPD
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
