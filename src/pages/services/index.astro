---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ServicesGrid from '@/components/sections/ServicesGrid';

import services from '@/data/services.json';
---

<BaseLayout
  title="Nos Services de Location de Bennes à Tours | Du 10m³ au 30m³"
  description="Découvrez notre gamme complète de bennes de location à Tours. Bennes 10m³, 15m³, 20m³, 30m³, gravats, tout-venant et bois. Tarifs compétitifs."
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="section-spacing bg-gradient-to-br from-primary-600 to-primary-800 text-white">
      <div class="container-custom text-center">
        <h1 class="text-display-sm md:text-display-md font-display font-bold mb-6">
          Nos Services de Location de Bennes
        </h1>
        <p class="text-xl text-primary-100 max-w-3xl mx-auto">
          Une gamme complète adaptée à tous vos besoins : rénovation, construction, démolition ou débarras.
        </p>
      </div>
    </section>

    <!-- Services Grid -->
    <ServicesGrid client:load services={services} />

    <!-- Info Section -->
    <section class="section-spacing bg-white">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-neutral-900 mb-8 text-center">
            Comment choisir la bonne benne ?
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-primary-50 p-6 rounded-xl">
              <h3 class="text-xl font-bold text-neutral-900 mb-3">Pour les particuliers</h3>
              <ul class="space-y-2 text-neutral-700">
                <li>• Petit débarras : Benne 10m³</li>
                <li>• Rénovation appartement : Benne 15m³</li>
                <li>• Rénovation maison : Benne 20m³</li>
                <li>• Gros travaux : Benne 30m³</li>
              </ul>
            </div>

            <div class="bg-secondary-50 p-6 rounded-xl">
              <h3 class="text-xl font-bold text-neutral-900 mb-3">Pour les professionnels</h3>
              <ul class="space-y-2 text-neutral-700">
                <li>• Démolition béton : Benne gravats</li>
                <li>• Chantier mixte : Benne tout-venant</li>
                <li>• Déchets bois : Benne bois</li>
                <li>• Gros chantier : Benne 30m³</li>
              </ul>
            </div>
          </div>

          <div class="mt-12 text-center">
            <p class="text-lg text-neutral-600 mb-6">
              Besoin de conseils pour choisir ?
            </p>
            <a href="/contact" class="btn-primary text-lg">
              Contactez nos experts
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
