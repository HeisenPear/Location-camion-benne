---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Button from '@/components/ui/Button.astro';
import type { Service } from '@/types';

import servicesData from '@/data/services.json';

export async function getStaticPaths() {
  return servicesData.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;

// Schema.org Service
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.name,
  description: service.description,
  provider: {
    '@type': 'LocalBusiness',
    name: 'Rudy Location 37',
    telephone: '+33 6 31 46 43 50',
    email: 'contact@rp-locationdebenne37.fr'
  },
  areaServed: {
    '@type': 'City',
    name: 'Tours',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Tours',
      postalCode: '37000',
      addressCountry: 'FR'
    }
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock'
  }
};

// Breadcrumbs Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Accueil',
      item: 'https://rp-locationdebenne37.fr'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Services',
      item: 'https://rp-locationdebenne37.fr/services'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: service.name,
      item: `https://rp-locationdebenne37.fr/services/${service.slug}`
    }
  ]
};

const combinedSchema = [schema, breadcrumbSchema];
---

<BaseLayout
  title={`${service.name} | Location de Benne Tours | Rudy Location 37`}
  description={`${service.description} Devis gratuit et personnalisé pour vos besoins en ${service.name.toLowerCase()}. Intervention rapide en Indre-et-Loire.`}
  schema={combinedSchema}
>
  <Header />

  <main>
    <!-- Breadcrumbs -->
    <div class="bg-neutral-50 py-4">
      <div class="container-custom">
        <nav class="flex text-sm" aria-label="Breadcrumb">
          <ol class="inline-flex items-center space-x-2">
            <li class="inline-flex items-center">
              <a href="/" class="text-neutral-600 hover:text-primary-600">Accueil</a>
            </li>
            <li>
              <div class="flex items-center">
                <svg class="w-4 h-4 text-neutral-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
                <a href="/services" class="text-neutral-600 hover:text-primary-600">Services</a>
              </div>
            </li>
            <li>
              <div class="flex items-center">
                <svg class="w-4 h-4 text-neutral-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-neutral-900 font-medium">{service.name}</span>
              </div>
            </li>
          </ol>
        </nav>
      </div>
    </div>

    <!-- Hero Service -->
    <section class="section-spacing bg-white">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto text-center">
          <div class="text-8xl mb-6">{service.icon}</div>

          <h1 class="text-display-sm md:text-display-md font-display font-bold text-neutral-900 mb-6">
            {service.name}
          </h1>

          <p class="text-xl text-neutral-600 mb-6 leading-relaxed">
            {service.description}
          </p>

          <p class="text-lg text-neutral-600 mb-8 leading-relaxed">
            {service.detailedDescription}
          </p>

          <div class="bg-primary-50 border-l-4 border-primary-600 p-6 mb-8 text-left inline-block">
            <div class="flex items-center">
              <svg class="w-6 h-6 text-primary-600 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
              </svg>
              <div>
                <span class="text-sm text-neutral-600 font-semibold">Idéal pour :</span>
                <span class="text-sm text-neutral-900 ml-2">{service.idealFor}</span>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <Button variant="primary" size="lg" href="/contact">
              Demander un devis gratuit
            </Button>
            <Button variant="outline" size="lg" href="tel:+33631464350">
              📞 06 31 46 43 50
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Détails du service -->
    <section class="py-16 bg-neutral-50">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
          <!-- Cas d'usage -->
          <div class="bg-white p-8 rounded-2xl shadow-soft">
            <h2 class="text-2xl font-bold text-neutral-900 mb-6 flex items-center">
              <svg class="w-7 h-7 text-primary-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
              Dans quelles situations ?
            </h2>
            <ul class="space-y-3">
              {service.useCases.map((useCase) => (
                <li class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-neutral-700">{useCase}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Types de déchets -->
          <div class="bg-white p-8 rounded-2xl shadow-soft">
            <h2 class="text-2xl font-bold text-neutral-900 mb-6 flex items-center">
              <svg class="w-7 h-7 text-primary-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              Déchets acceptés
            </h2>
            <ul class="space-y-3">
              {service.wasteTypes.map((wasteType) => (
                <li class="flex items-start space-x-3">
                  <span class="w-2 h-2 bg-primary-600 rounded-full mt-2 flex-shrink-0"></span>
                  <span class="text-neutral-700">{wasteType}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Avantages -->
    <section class="section-spacing bg-white">
      <div class="container-custom">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-neutral-900 mb-8 text-center">
            Nos avantages pour ce service
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {service.benefits.map((benefit) => (
              <div class="bg-primary-50 p-6 rounded-xl flex items-start">
                <svg class="w-6 h-6 text-primary-600 mr-4 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-neutral-700">{benefit}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="section-spacing bg-gradient-to-br from-primary-600 to-primary-800 text-white">
      <div class="container-custom text-center">
        <h2 class="text-display-sm font-bold mb-6">Prêt à démarrer votre projet ?</h2>
        <p class="text-xl text-primary-100 mb-8 max-w-2xl mx-auto">
          Contactez-nous dès maintenant pour obtenir un devis gratuit et personnalisé adapté à vos besoins.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="btn-secondary text-lg">
            Demander un devis gratuit
          </a>
          <a href="/services" class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold bg-white/10 backdrop-blur-sm border-2 border-white text-white hover:bg-white hover:text-primary-700 rounded-lg transition-all duration-200">
            Voir tous les services
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
