---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ContactForm from '@/components/forms/ContactForm';

import company from '@/data/company.json';
---

<BaseLayout
  title="Contact - Rudy Location 37 | Devis Gratuit 24h"
  description="Contactez Rudy Location 37. Devis gratuit en 24h. Téléphone, email, formulaire. Intervention en Indre-et-Loire et Région Centre."
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="section-spacing bg-gradient-to-br from-primary-600 to-primary-800 text-white">
      <div class="container-custom text-center">
        <h1 class="text-display-sm md:text-display-md font-display font-bold mb-6">
          Contactez-nous
        </h1>
        <p class="text-xl text-primary-100 max-w-3xl mx-auto">
          Une question ? Un projet ? Nous vous répondons sous 24h.
        </p>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="section-spacing bg-white">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Formulaire -->
          <div>
            <h2 class="text-3xl font-bold text-neutral-900 mb-6">
              Envoyez-nous un message
            </h2>
            <ContactForm client:load />
          </div>

          <!-- Informations de contact -->
          <div>
            <h2 class="text-3xl font-bold text-neutral-900 mb-6">
              Nos coordonnées
            </h2>

            <div class="space-y-6">
              <!-- Téléphone -->
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-lg text-neutral-900 mb-1">Téléphone</h3>
                  <a href={`tel:${company.phone}`} class="text-primary-600 hover:underline text-lg">
                    {company.phone.replace('+33', '0').replace(/(\d{2})/g, '$1 ').trim()}
                  </a>
                  <p class="text-sm text-neutral-600 mt-1">Disponible du lundi au samedi</p>
                </div>
              </div>

              <!-- Email -->
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-lg text-neutral-900 mb-1">Email</h3>
                  <a href={`mailto:${company.email}`} class="text-primary-600 hover:underline">
                    {company.email}
                  </a>
                  <p class="text-sm text-neutral-600 mt-1">Réponse sous 24h</p>
                </div>
              </div>

              <!-- Zone d'intervention -->
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-lg text-neutral-900 mb-1">Zone d'intervention</h3>
                  <p class="text-neutral-700">
                    Indre-et-Loire (37)<br/>
                    et Région Centre
                  </p>
                  <a href="/zones-intervention" class="text-primary-600 hover:underline text-sm mt-1 inline-block">
                    Voir toutes nos zones
                  </a>
                </div>
              </div>

              <!-- Horaires -->
              <div class="bg-primary-50 p-6 rounded-xl">
                <h3 class="font-bold text-lg text-neutral-900 mb-3">Horaires d'ouverture</h3>
                <dl class="space-y-2 text-neutral-700">
                  <div class="flex justify-between">
                    <dt>Lundi - Vendredi</dt>
                    <dd class="font-semibold">8h00 - 18h00</dd>
                  </div>
                  <div class="flex justify-between">
                    <dt>Samedi</dt>
                    <dd class="font-semibold">9h00 - 12h00</dd>
                  </div>
                  <div class="flex justify-between">
                    <dt>Dimanche</dt>
                    <dd class="font-semibold text-neutral-500">Fermé</dd>
                  </div>
                </dl>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
